{
  "envOverrides": {
    "/service/bindAddress": "SERVICE_BIND_ADDRESS"
  },
  "service": {
    "name": "skw-api-gate",
    "bindAddress": "0.0.0.0:8443",
    "workers": 2,
    "backTopicpartitionsCount": 64,
    "tls": {
      "subjectAltNames": ["localhost", "127.0.0.1", "skw-api-gate"],
      "certPath": "../../conf/skw-api-gate.cert.pem",
      "keyPath": "../../conf/skw-api-gate.key.pem"
    },
    "authServiceUrl": "http://localhost:9001",
    "rootKey": "01a01500-98d5-71fc-9038-71acb78d61c4"
  },
  "iggy": {
    "url": "iggy://iggy:Secret123!@localhost:8081",
    "streamPrefix": "api-gate-stream"
  },
  "topicsMap": {
    "ping":{
      "customName": "",
      "partitionsCount": 100,
      "messageExpiry": 31
    }
  }
}
